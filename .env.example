# ---------------------------------------------------------------------------
# Heydit — Agentic AI Video Editor
# Copy this file to `.env` and fill in the keys for the cloud providers you use.
# Any key left blank makes the corresponding tool fall back to a local STUB so
# the whole app still runs end-to-end (great for demos / development).
# ---------------------------------------------------------------------------

# The agentic "brain". Used to interpret your natural-language edit requests
# and to fix grammar in transcribed speech. Get one at console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8

# Speech-to-text + text-to-speech for the "correct grammar in sound" tool.
# OpenAI provides both Whisper (STT) and TTS. https://platform.openai.com
OPENAI_API_KEY=
OPENAI_STT_MODEL=whisper-1
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=alloy

# Replicate powers the visual generative tools (frame expansion / outpainting
# and video background replacement via matting). https://replicate.com
REPLICATE_API_TOKEN=
REPLICATE_OUTPAINT_MODEL=black-forest-labs/flux-fill-dev
REPLICATE_MATTING_MODEL=arielreplicate/robust_video_matting

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
STORAGE_DIR=storage
# Set to "1" to force every tool into stub mode regardless of keys present.
FORCE_STUB=0
